<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ml_planner_data</name>
  <version>0.2.0</version>
  <description>Tools to build ML planner training data directly from rosbags</description>
  <maintainer email="yukinari.hisaki.2@tier4.jp">Yukinari Hisaki</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>autoware_ml_planner</depend>
  <depend>autoware_geography_utils</depend>
  <depend>autoware_lanelet2_extension</depend>
  <depend>autoware_map_projection_loader</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_vehicle_info_utils</depend>
  <depend>autoware_vehicle_msgs</depend>
  <depend>libexpected-dev</depend>
  <depend>nav_msgs</depend>
  <depend>pybind11_vendor</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>xtensor</depend>
  <depend>yaml_cpp_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
