repositories:
  # core
  deps/autoware_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_msgs.git
    # autoware_core requires autoware_localization_msgs/InitializeLocalization.
    # That service was added after 1.7.0; 1.9.0 is the minimum compatible tag.
    version: 1.9.0
  deps/autoware_adapi_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_adapi_msgs.git
    version: 1.9.1
  deps/autoware_internal_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_internal_msgs.git
    version: 1.14.0
  deps/autoware_cmake:
    type: git
    url: https://github.com/autowarefoundation/autoware_cmake.git
    version: 1.4.0
  deps/autoware_utils:
    type: git
    url: https://github.com/autowarefoundation/autoware_utils.git
    version: 1.5.0
  deps/autoware_lanelet2_extension:
    type: git
    url: https://github.com/autowarefoundation/autoware_lanelet2_extension.git
    version: 1.2.0
  deps/autoware_core:
    type: git
    url: https://github.com/autowarefoundation/autoware_core.git
    version: 8f4a78d9339909760f30bd423f7701370efd80ec
  deps/autoware_rviz_plugins:
    type: git
    url: https://github.com/autowarefoundation/autoware_rviz_plugins.git
    version: 0.4.0
  # universe
  deps/autoware_universe:
    type: git
    url: https://github.com/tier4/autoware_universe.git
    version: feat/v0.64/e2e
  deps/tier4_autoware_msgs:
    type: git
    url: https://github.com/tier4/tier4_autoware_msgs.git
    version: v0.58.0
  deps/muSSP:
    type: git
    url: https://github.com/tier4/muSSP.git
    version: c79e98fd5e658f4f90c06d93472faa977bc873b9
  deps/pointcloud_to_laserscan:
    type: git
    url: https://github.com/tier4/pointcloud_to_laserscan.git
    version: d969ec699f84fad827fbadfa3001c9c657482fbe
  deps/glog:  # TODO(Horibe): to use isGoogleInitialized() API in v0.6.0. Remove when the rosdep glog version is updated to v0.6.0 (already updated in Ubuntu 24.04)
    type: git
    url: https://github.com/tier4/glog.git
    version: ea36766fdc2ac8e8c8e3ac988ae69acd6d09bb30
  deps/bevdet_vendor: # TODO: wrap the original bevdet-tensorrt-cpp source code as a vendor package and provide it to autoware_tensorrt_bevdet package
    type: git
    url: https://github.com/autowarefoundation/bevdet_vendor.git
    version: 0.1.0
  deps/cuda_blackboard:
    type: git
    url: https://github.com/autowarefoundation/cuda_blackboard.git
    version: 0.3.0
  deps/negotiated:
    type: git
    url: https://github.com/osrf/negotiated.git
    version: eac198b55dcd052af5988f0f174902913c5f20e7
  deps/managed_transform_buffer:
    type: git
    url: https://github.com/autowarefoundation/managed_transform_buffer.git
    version: 0.2.0
  # sensor_component
  deps/sensor_component_description:
    type: git
    url: https://github.com/tier4/sensor_component_description.git
    version: 03ba094851ec90febfcfc0adb20b64b0e19df7a8
